<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Ethical_ABPMS" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Ethical_ABPMS" name="فرآیند کمک مالی دانشجویی" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="شروع"/>
    <bpmn:task id="Activity_2" name="ثبت درخواست">
      <bpmn:documentation>این فعالیت با رعایت اصول اخلاقی A-BPMS طراحی شده است.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Activity_3" name="بررسی مدارک">
      <bpmn:documentation>این فعالیت با رعایت اصول اخلاقی A-BPMS طراحی شده است.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Activity_4" name="ارزیابی نیاز مالی">
      <bpmn:documentation>این فعالیت با رعایت اصول اخلاقی A-BPMS طراحی شده است.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Activity_5" name="بررسی تبعیض">
      <bpmn:documentation>این فعالیت برای جلوگیری از تبعیض طراحی شده است. متغیرهای حساس مانند جنسیت نباید مستقیماً در تصمیم‌گیری استفاده شوند.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_6" name="تصمیم نهایی">
      <bpmn:documentation>این گیت تصمیم‌گیری را به مسیرهای تأیید و رد تفکیک می‌کند. مسیر تصمیم نباید بر اساس متغیرهای حساس مانند جنسیت تعیین شود.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_7" name="تأیید">
      <bpmn:documentation>این فعالیت با رعایت اصول اخلاقی A-BPMS طراحی شده است.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Activity_8" name="رد">
      <bpmn:documentation>این فعالیت با رعایت اصول اخلاقی A-BPMS طراحی شده است. دلیل تصمیم باید برای متقاضی قابل فهم باشد.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Activity_9" name="درخواست بازبینی">
      <bpmn:documentation>این فعالیت برای تضمین قابلیت اعتراض متقاضی و فراهم کردن مسیر رسمی درخواست تجدیدنظر ایجاد شده است.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Activity_10" name="بازبینی درخواست">
      <bpmn:documentation>این فعالیت برای بررسی مستقل درخواست تجدیدنظر و افزایش پاسخ‌گویی فرآیند ایجاد شده است.</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ExclusiveGateway_11" name="تصمیم نهایی پس از بازبینی">
      <bpmn:documentation>این گیت نتیجه بازبینی مستقل را بررسی می‌کند. تصمیم مجدد باید بر اساس معیارهای مرتبط با شرایط مالی و شرایط احراز باشد و نباید بر اساس متغیرهای حساس مانند جنسیت اتخاذ شود.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_12" name="تأیید پس از بازبینی">
      <bpmn:documentation>درخواست پس از بازبینی تأیید شده است. تصمیم بر اساس معیارهای مرتبط با شرایط احراز و بدون تبعیض اتخاذ شده است.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Activity_13" name="رد پس از بازبینی">
      <bpmn:documentation>درخواست پس از بازبینی نیز رد شده است. دلیل رد باید به صورت شفاف و قابل فهم برای متقاضی ثبت و اعلام شود.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="Activity_14" name="ابلاغ نتیجه">
      <bpmn:documentation>نتیجه تصمیم باید به‌صورت شفاف و قابل فهم به متقاضی ابلاغ شود.</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_15" name="پایان"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_2"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_2" targetRef="Activity_3"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_3" targetRef="Activity_4"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_4" targetRef="Activity_5"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_5" targetRef="ExclusiveGateway_6"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="ExclusiveGateway_6" targetRef="Activity_7" name="تأیید">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">شرایط احراز شده است</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="ExclusiveGateway_6" targetRef="Activity_8" name="رد">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">شرایط احراز نشده است</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_8" targetRef="Activity_9" name="درخواست بازبینی">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">متقاضی درخواست بازبینی دارد</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_9" targetRef="Activity_10" name="ارجاع برای بازبینی"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_10" targetRef="ExclusiveGateway_11" name="نتیجه بازبینی"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ExclusiveGateway_11" targetRef="Activity_12" name="تأیید پس از بازبینی">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">شرایط پس از بازبینی احراز شده است</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ExclusiveGateway_11" targetRef="Activity_13" name="رد پس از بازبینی">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">شرایط پس از بازبینی احراز نشده است</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_7" targetRef="Activity_14" name="ابلاغ نتیجه تأیید"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_8" targetRef="Activity_14" name="ابلاغ نتیجه رد">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">متقاضی درخواست بازبینی ندارد</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Activity_12" targetRef="Activity_14" name="ابلاغ تأیید پس از بازبینی"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_13" targetRef="Activity_14" name="ابلاغ رد پس از بازبینی"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_14" targetRef="EndEvent_15"/>
  </bpmn:process>
